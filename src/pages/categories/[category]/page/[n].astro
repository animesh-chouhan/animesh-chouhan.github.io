---
import Redirect from "../../../../components/Redirect.astro";
import { terms } from "../../../../lib/content";

export async function getStaticPaths() {
  return (await terms("categories")).map((term) => ({ params: { category: term.slug, n: "1" }, props: { slug: term.slug } }));
}
---

<Redirect to={`/categories/${Astro.props.slug}/`} />
