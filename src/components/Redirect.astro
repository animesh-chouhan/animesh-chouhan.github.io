---
// Stands in for the /page/1/-style redirect pages Zola used to generate, so old links keep working.
import { SITE } from "../site";

interface Props {
  to: string;
}

const url = new URL(Astro.props.to, SITE.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Redirect</title>
    <link rel="canonical" href={url} />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${Astro.props.to}`} />
  </head>
  <body>
    <p><a href={url}>Click here</a> to be redirected.</p>
  </body>
</html>
